test/output/

# JSAG paper-generated figures/numbers (regenerated by paper_artifacts/*.jl)
paper_artifacts/

# macOS
.DS_Store

# Cursor IDE (local rules, ignore list, agent state/cache)
.cursorrules
.cursor/
.cursorignore

# Claude Code (local tool config/session state; agent definitions under
